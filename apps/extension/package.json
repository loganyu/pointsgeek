{
  "name": "@points-geek/extension",
  "description": "Points Geek - Track your credit card points and miles",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:staging": "WXT_MODE=staging wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:local": "WXT_MODE=development wxt build",
    "build:staging": "WXT_MODE=staging wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:staging": "WXT_MODE=staging wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@points-geek/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "wxt": "^0.20.20"
  }
}
