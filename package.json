{
  "name": "points-geek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @points-geek/web dev",
    "dev:ext": "pnpm --filter @points-geek/extension dev",
    "dev:ext:staging": "pnpm --filter @points-geek/extension dev:staging",
    "build": "pnpm --filter @points-geek/web build",
    "build:amplify": "pnpm --filter @points-geek/web build:amplify",
    "build:vercel": "pnpm --filter @points-geek/web build:vercel",
    "build:ext": "pnpm --filter @points-geek/extension build",
    "build:ext:local": "pnpm --filter @points-geek/extension build:local",
    "build:ext:staging": "pnpm --filter @points-geek/extension build:staging",
    "zip:ext": "pnpm --filter @points-geek/extension zip",
    "zip:ext:staging": "pnpm --filter @points-geek/extension zip:staging",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "db:generate": "pnpm --filter @points-geek/web db:generate",
    "db:migrate": "pnpm --filter @points-geek/web db:migrate",
    "db:migrate:deploy": "pnpm --filter @points-geek/web db:migrate:deploy",
    "db:studio": "pnpm --filter @points-geek/web db:studio"
  },
  "packageManager": "pnpm@10.33.0"
}
