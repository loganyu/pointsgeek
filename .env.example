# Local PostgreSQL. Leave unset on Amplify when using Aurora Data API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/point_portfolio

# Aurora Serverless v2 Data API. Leave unset for local PostgreSQL.
AURORA_REGION=
AURORA_RESOURCE_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-to-a-random-secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@yourdomain.com
ADMIN_SIGNUP_ALERT_EMAIL=
EXTENSION_ID=development
LOG_LEVEL=debug
NEXT_PUBLIC_GA_MEASUREMENT_ID=
